{
  "name": "opencode-config-d",
  "version": "0.1.0",
  "description": "Native OpenCode V2 plugin for scoped config.d defaults",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bundle": "bun run bundle.ts",
    "prepublishOnly": "bun run bundle"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.32",
    "@opencode/schema": "2.0.32",
    "effect": "4.0.1"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.32",
    "@opencode/schema": "2.0.32",
    "effect": "4.0.1",
    "@types/bun": "1.3.14",
    "@types/node": "25.8.0",
    "typescript": "6.0.3"
  }
}
