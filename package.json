{
  "name": "opencode-config-d",
  "version": "0.1.0",
  "description": "opencode plugin for loading config overlays from config.d",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "bundle": "bun run bundle.ts",
    "prepublishOnly": "bun run bundle"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.15.0",
    "@types/bun": "1.3.14",
    "@types/node": "25.8.0",
    "bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
